# Copy to .env and fill in:  cp .env.example .env

# Telegram bot token from @BotFather.
TOKEN=

# Base URL of the Дұрыс сөйле API, the prefix of /words and /audio.
API_BASE_URL=https://example.org/api/v1.0

# Only for a second instance on the same host (e.g. a staging bot): a project
# name of its own, so it gets its own container, image and state volume.
#COMPOSE_PROJECT_NAME=durys-soile-bot-staging
